# Optional path override for an authenticated GitHub Copilot CLI executable.
COPILOT_CLI=copilot

# Optional Copilot CLI model override; empty uses automatic model selection.
COPILOT_MODEL=

# Optional result notifications. Leave unset to skip that channel.
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Optional local token for GitHub Models. GitHub Actions supplies GITHUB_TOKEN automatically.
GITHUB_TOKEN=

# Optional GitHub Models configuration.
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference/chat/completions

# Optional result notifications. Leave unset to skip that channel.
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
